# Copy to .env and fill in real values. Dummy data below - DO NOT use in prod.
HOST=0.0.0.0
PORT=9999

# SQLite fallback file (used when DATABASE_URL is not a dialect URL)
DATABASE_NAME=coredriven.db
# Full SQLAlchemy URL, e.g. sqlite:///coredriven.db or postgresql+psycopg2://user:pass@localhost:5432/coredriven
DATABASE_URL=sqlite:///coredriven.db

JWT_ALGORITHM=HS256
PASSWORD_HASH_SECRET_KEY=change-me-to-a-long-random-secret-min-32-chars
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
